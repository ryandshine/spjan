# Salin ke .env untuk pengembangan lokal.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:55432/spjan_dev
FRONTEND_ORIGIN=http://localhost:5173
# Dipakai hanya untuk membuat akun pertama bila tabel users kosong.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-kata-sandi-ini
# Direktori penyimpanan berkas unggahan (Tahap 2).
BERKAS_DIR=./data/berkas
# URL Ollama lokal untuk pengembangan (model vision/teks); default http://172.17.0.1:11434 di produksi.
OLLAMA_URL=http://127.0.0.1:11434
